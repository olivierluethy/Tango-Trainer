{
  "name": "tango-trainer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A teach-first trainer for the LinkedIn Tango logic puzzle. Shows WHAT is wrong, WHY, and HOW to fix it.",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build:css": "tailwindcss -i ./src/css/input.css -o ./dist/app.css",
    "watch:css": "tailwindcss -i ./src/css/input.css -o ./dist/app.css --watch",
    "serve": "node scripts/serve.mjs",
    "dev": "npm run vendor && concurrently -k -n css,server -c cyan,magenta \"npm:watch:css\" \"npm:serve\"",
    "build": "npm run vendor && npm run build:css",
    "build:single": "npm run build && node scripts/build-single.mjs",
    "test": "node --test \"test/*.test.js\""
  },
  "devDependencies": {
    "@fontsource/fraunces": "^5.0.0",
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "@fontsource/ibm-plex-sans": "^5.0.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.28.1",
    "lucide": "^0.460.0",
    "motion": "^11.11.0",
    "tailwindcss": "^3.4.0"
  }
}
